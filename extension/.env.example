# Where the dashboard runs. Port 3001 because 3000 is taken locally.
# Must match `npm run dev` in web/ or the model-backed reading and intent
# extraction silently fall back to the offline versions.
VITE_APP_URL=http://localhost:3001

# Which chain this build talks to: "mainnet" or "testnet". Drives the label in
# the popup header. Anything other than "mainnet" is treated as testnet.
VITE_NETWORK=testnet
