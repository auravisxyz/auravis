# Copy to .env and fill in. Never commit .env — see RULES.md #6.

# --- Chain ---------------------------------------------------------------
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
XLAYER_MAINNET_CHAIN_ID=196
XLAYER_TESTNET_CHAIN_ID=1952

# --- Deployment (contracts/script/Deploy.s.sol) ---------------------------
# Disposable deploy key. Never a personal key. See RULES.md #7.
DEPLOYER_PRIVATE_KEY=
VAULT_OWNER=
AGENT_ADDRESS=
OKX_DEX_ROUTER=

# --- Deployed contracts --------------------------------------------------
MANDATE_ADDRESS_TESTNET=
MANDATE_ADDRESS_MAINNET=

# --- Testnet rehearsal rig (DeployTestnetRig.s.sol prints these) ----------
MOCK_ROUTER_TESTNET=
MOCK_USDT_TESTNET=
MOCK_USDC_TESTNET=

# --- Agent ---------------------------------------------------------------
# Disposable hot wallet only. Never a personal key. See RULES.md #7.
AGENT_PRIVATE_KEY=
AGENT_POLL_INTERVAL_MS=15000

# --- Owner ---------------------------------------------------------------
# Used ONLY by setup scripts (allowlist router, deposit, open mandate).
# The agent service never reads this and must never be given it — the whole
# security model is that this key can overrule the agent key. On mainnet the
# deployer, owner and agent must be THREE DIFFERENT keys.
OWNER_PRIVATE_KEY=

# --- OKX ------------------------------------------------------------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
# ERC-8021 attribution suffix — see docs/technical-findings.md
BUILDER_CODE=

# --- AI -------------------------------------------------------------------
# Used for intent extraction and writing action explanations
MODEL_API_KEY=

# --- Data -----------------------------------------------------------------
# After setting this, run `npm run db:migrate` inside agent/ once to create
# the triggers/executions tables (see agent/src/db/migrations/0001_init.sql).
DATABASE_URL=

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mainnet demo router (DeployDemoRouter.s.sol prints this)
DEMO_ROUTER_MAINNET=
